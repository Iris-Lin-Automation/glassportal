# See https://nextjs.org/docs/app/building-your-application/configuring-environment-variables
# Copy to `.env.local` for local secrets (gitignored).

# Optional server-side fallback when no client token is provided
NOTION_API_TOKEN=

# Durable storage on Vercel (Upstash Redis / Vercel KV). Without this, plans reset on cold starts.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# or:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Checkout links (shown in Studio Plan card)
NEXT_PUBLIC_GUMROAD_CHECKOUT_PRO=
NEXT_PUBLIC_GUMROAD_CHECKOUT_AGENCY=
NEXT_PUBLIC_LEMON_CHECKOUT_PRO=
NEXT_PUBLIC_LEMON_CHECKOUT_AGENCY=

# Gumroad Ping → https://YOUR_DOMAIN/api/webhooks/gumroad
GUMROAD_WEBHOOK_SECRET=
GUMROAD_DEFAULT_PLAN=pro

# Manual fulfill (you upgrade a buyer from email):
# POST /api/plan  { "action":"fulfill", "email":"buyer@x.com", "plan":"pro", "secret":"..." }
FULFILLMENT_SECRET=

# Local/dev only: allow clicking Pro in Studio without checkout
# ALLOW_OPEN_PLAN_SWITCH=1

NEXT_PUBLIC_APP_HOST=glassportal.vercel.app
NEXT_PUBLIC_PORTAL_DOMAIN=glassportal.vercel.app

# --- Generative UI Playground (server-only, never commit real keys) ---
# Name stays OPENAI_API_KEY even for Groq / OpenRouter / DeepSeek (OpenAI-compatible).
OPENAI_API_KEY=

# Groq (often has free quota): https://console.groq.com/keys
OPENAI_BASE_URL=https://api.groq.com/openai/v1
# Current Groq chat models (list via GET /openai/v1/models): openai/gpt-oss-20b, openai/gpt-oss-120b, qwen/qwen3.8-27b
GENUI_MODEL=openai/gpt-oss-20b

# OpenRouter: https://openrouter.ai/keys
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# GENUI_MODEL=openai/gpt-4o-mini

# OpenAI official:
# OPENAI_BASE_URL=https://api.openai.com/v1
# GENUI_MODEL=gpt-4o-mini

# DeepSeek: https://platform.deepseek.com/
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# GENUI_MODEL=deepseek-chat
