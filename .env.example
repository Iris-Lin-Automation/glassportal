# See https://nextjs.org/docs/app/building-your-application/configuring-environment-variables

# Optional server-side fallback when no client token is provided
NOTION_API_TOKEN=

# Durable storage on Vercel (Upstash Redis / Vercel KV). Without this, plans reset on cold starts.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# or:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Checkout links (shown in Studio Plan card)
NEXT_PUBLIC_GUMROAD_CHECKOUT_PRO=
NEXT_PUBLIC_GUMROAD_CHECKOUT_AGENCY=
NEXT_PUBLIC_LEMON_CHECKOUT_PRO=
NEXT_PUBLIC_LEMON_CHECKOUT_AGENCY=

# Gumroad Ping → https://YOUR_DOMAIN/api/webhooks/gumroad
GUMROAD_WEBHOOK_SECRET=
GUMROAD_DEFAULT_PLAN=pro

# Manual fulfill (you upgrade a buyer from email):
# POST /api/plan  { "action":"fulfill", "email":"buyer@x.com", "plan":"pro", "secret":"..." }
FULFILLMENT_SECRET=

# Local/dev only: allow clicking Pro in Studio without checkout
# ALLOW_OPEN_PLAN_SWITCH=1

NEXT_PUBLIC_APP_HOST=glassportal.vercel.app
NEXT_PUBLIC_PORTAL_DOMAIN=glassportal.vercel.app
